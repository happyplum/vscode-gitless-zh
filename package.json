{
	"name": "gitless-zh",
	"displayName": "GitLess 简体中文版",
	"description": "GitLess 简体中文版：基于 GitLens 的 VS Code Git 工具",
	"version": "11.7.8",
	"packageManager": "yarn@1.22.22",
	"publisher": "happyplum",
	"license": "SEE LICENSE IN LICENSE",
	"bugs": {
		"url": "https://github.com/happyplum/vscode-gitless-zh/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/happyplum/vscode-gitless-zh.git"
	},
	"engines": {
		"vscode": "^1.101.0",
		"node": ">=22.11.0"
	},
	"main": "./dist/gitlens",
	"preview": false,
	"categories": [
		"Other"
	],
	"galleryBanner": {
		"color": "#8647ae",
		"theme": "dark"
	},
	"keywords": [
		"gitlens",
		"git",
		"blame",
		"log",
		"annotation",
		"multi-root ready"
	],
	"activationEvents": [
		"onFileSystem:gitlens",
		"onStartupFinished"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": "limited"
		}
	},
	"scripts": {
		"analyze:bundle": "webpack --env analyzeBundle",
		"analyze:deps": "webpack --env analyzeDeps",
		"build": "webpack --mode development",
		"build:extension": "webpack --mode development --config-name extension",
		"build:webviews": "webpack --mode development --config-name webviews",
		"bundle": "webpack --mode production",
		"clean": "rimraf --glob .eslintcache* tsconfig*.tsbuildinfo",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"pack": "node ./scripts/packExtension.js",
		"pack-insiders": "node ./scripts/packInsiders.js",
		"pretty": "prettier --config .prettierrc --log-level warn --write .",
		"pub": "node ./scripts/packExtension.js --publish",
		"rebuild": "yarn run reset && yarn run build",
		"reset": "yarn run clean && yarn --frozen-lockfile",
		"watch": "webpack --watch --mode development",
		"watch:extension": "webpack --watch --mode development --config-name extension",
		"watch:webviews": "webpack --watch --mode development --config-name webviews",
		"update-dts": "pushd \"src/@types\" && npx vscode-dts dev && popd",
		"update-dts:master": "pushd \"src/@types\" && npx vscode-dts master && popd",
		"update-emoji": "node ./scripts/generateEmojiShortcodeMap.js",
		"update-licenses": "node ./scripts/generateLicenses.js",
		"vscode:prepublish": "yarn run bundle",
		"prepare:extension": "node ./scripts/extensionManifest.js"
	},
	"dependencies": {
		"@octokit/graphql": "9.0.5",
		"@vscode/codicons": "0.0.45",
		"chroma-js": "3.2.0",
		"dayjs": "1.11.23",
		"iconv-lite": "0.7.3",
		"lodash-es": "4.18.1",
		"sortablejs": "1.15.7"
	},
	"devDependencies": {
		"@types/chroma-js": "3.1.3",
		"@types/lodash-es": "4.17.12",
		"@types/node": "22.20.5",
		"@types/sortablejs": "1.15.9",
		"@types/vscode": "1.101.0",
		"@typescript-eslint/eslint-plugin": "8.72.0",
		"@typescript-eslint/parser": "8.72.0",
		"@vscode/vsce": "4.0.0",
		"ansi-regex": "6.4.0",
		"circular-dependency-plugin": "5.2.2",
		"clean-webpack-plugin": "4.0.0",
		"copy-webpack-plugin": "14.0.0",
		"csp-html-webpack-plugin": "5.1.0",
		"css-loader": "7.1.5",
		"esbuild": "0.28.2",
		"esbuild-loader": "4.5.0",
		"eslint": "9.39.5",
		"globals": "17.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-import": "2.32.0",
		"fork-ts-checker-webpack-plugin": "9.1.0",
		"html-loader": "5.1.0",
		"html-webpack-plugin": "5.6.8",
		"image-minimizer-webpack-plugin": "5.0.0",
		"license-checker": "25.0.1",
		"mini-css-extract-plugin": "2.10.2",
		"prettier": "3.9.10",
		"rimraf": "6.1.3",
		"sass": "1.106.1",
		"sass-loader": "17.0.1",
		"sharp": "0.35.5",
		"typescript": "6.0.3",
		"webpack": "5.112.0",
		"webpack-bundle-analyzer": "5.4.0",
		"webpack-cli": "7.2.3"
	}
}
